{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inventario",
  "version": "0.1.0",
  "identifier": "com.inventario.desktop",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": [
      "resources/server/**/*"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "compression": "zlib"
      }
    }
  }
}
